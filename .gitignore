# ─────────────────────────────────────────
# 秘密のファイル（GitHub に送らない）
# ─────────────────────────────────────────
.env
.env.*
secrets/
*.key
credentials.json

# ただし、値の入っていない見本は送ってよい
!.env.example


# ─────────────────────────────────────────
# Python が自動で作るもの
# ─────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/


# ─────────────────────────────────────────
# エディタ・OS が自動で作るもの
# ─────────────────────────────────────────
.vscode/
.DS_Store
Thumbs.db


# ─────────────────────────────────────────
# 取得したニュースの保存先（必要に応じて）
# ─────────────────────────────────────────
reports/


# ─────────────────────────────────────────
# 注意
#
# .gitignore に書いたから絶対に安全、ではありません。
# 一度 GitHub に送ってしまったファイルは、
# あとからここに書いても履歴に残り続けます。
#
# もし漏れた可能性があるときは、
# キーを失効させて発行し直すのが確実です。
# ─────────────────────────────────────────
